@model GLMS.Models.Contract

<h2>Contract Details</h2>

<dl class="row">
    <dt class="col-sm-3">Client</dt>
    <dd class="col-sm-9">@Model.Client?.Name</dd>

    <dt class="col-sm-3">Start Date</dt>
    <dd class="col-sm-9">@(Model.StartDate?.ToShortDateString() ?? "Not specified")</dd>

    <dt class="col-sm-3">End Date</dt>
    <dd class="col-sm-9">@(Model.EndDate?.ToShortDateString() ?? "Not specified")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>

    <dt class="col-sm-3">Service Level</dt>
    <dd class="col-sm-9">@Model.ServiceLevel</dd>

    <dt class="col-sm-3">PDF</dt>
    <dd class="col-sm-9">
        @if (Model.SignedAgreementPath != null)
        {
            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-sm btn-warning">Download PDF</a>
        }
        else
        {
            <span>No file uploaded</span>
        }
    </dd>
</dl>

<h4 class="mt-3">Service Requests</h4>

@if (Model.ServiceRequests.Any())
{
    <ul>
        @foreach (var sr in Model.ServiceRequests)
        {
            <li>
                @sr.Description —
                $ @sr.CostUSD.ToString("N2") USD /
                R @sr.CostZAR.ToString("N2") ZAR —
                @sr.Status
            </li>
        }
    </ul>
}
else
{
    <p>No service requests yet.</p>
}

<a asp-action="Index" class="btn btn-secondary mt-2">Back</a>